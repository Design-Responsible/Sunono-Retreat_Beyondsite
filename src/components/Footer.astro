---
import { site, footer } from '../data/content';
import Icon from './Icon.astro';
const year = new Date().getFullYear();
const base = Astro.url.pathname === '/' ? '' : '/';
---
<footer class="ft">
  <div class="bg" aria-hidden="true"><img src={footer.photo} alt="" loading="lazy" /></div>
  <div class="wrap">
    <div class="cols">
      <div class="col">
        <p class="t-label h">Address</p>
        <p class="addr">{site.address[0]}<br />{site.address[1]}</p>
        <a class="sm" href={`mailto:${site.email}`}>{site.email}</a>
        <a class="sm" href={`tel:${site.phone.replace(/\s/g, '')}`}>{site.phone}</a>
        <a class="btn btn-cream cta" href={`${base}#book`}>Check availability <Icon name="arrow" class="arrow" /></a>
      </div>
      <div class="col"><p class="t-label h">The house</p>{footer.house.map(([l, h]) => <a class="sm" href={`${base}${h}`}>{l}</a>)}</div>
      <div class="col"><p class="t-label h">Socials</p>{footer.socials.map(([l, h]) => <a class="sm" href={h} target="_blank" rel="noopener">{l}</a>)}</div>
      <div class="col"><p class="t-label h">Getting here</p>{footer.gettingHere.map((l) => <p class="sm">{l}</p>)}
        <a class="sm dir" href="https://www.google.com/maps/search/?api=1&query=Huon+Valley+Tasmania" target="_blank" rel="noopener">Directions <Icon name="arrow" class="arrow" /></a></div>
    </div>
    <a class="giant" href="#top" aria-label={`${site.name}, back to top`} data-giant><span>{site.name}</span></a>
    <div class="base">
      <p class="t-label">© {year} {site.name}</p>
      <a class="t-label" href="#top">Back to top</a>
    </div>
  </div>
</footer>

<style>
  .ft { position: relative; background: var(--ink); overflow: hidden; padding-top: 220px; }
  .bg { position: absolute; inset: 0 0 auto 0; height: 520px; }
  .bg img { width: 100%; height: 100%; object-fit: cover; opacity: .45; }
  .bg::after { content: ''; position: absolute; inset: 0; background: linear-gradient(180deg, rgb(13 12 10 / .2), var(--ink) 92%); }
  .wrap { position: relative; }
  .cols { display: grid; grid-template-columns: repeat(4, 1fr); gap: 40px; }
  .col { display: flex; flex-direction: column; gap: 8px; align-items: flex-start; }
  .h { color: var(--cream-muted); margin-bottom: 12px; }
  .addr { font-size: 18px; line-height: 1.6; margin-bottom: 8px; }
  .sm { font-size: 15px; color: var(--cream-soft); transition: color .2s; }
  a.sm:hover { color: var(--cream); }
  .dir { display: inline-flex; gap: 8px; align-items: center; }
  .dir :global(.arrow) { width: 13px; height: 13px; }
  .cta { margin-top: 14px; }
  .giant { display: block; margin-top: 110px; line-height: .8; }
  .giant span { display: block; font-size: 20vw; font-weight: 400; white-space: nowrap; letter-spacing: -0.045em; text-align: center; line-height: .9; padding-bottom: .1em;
    transform: translateY(var(--gy, 30%)); transition: transform .1s linear; }
  .giant { overflow: hidden; }
  .base { display: flex; justify-content: space-between; padding: 24px 0 36px; color: var(--cream-soft); }
  @media (max-width: 900px) { .cols { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 520px) { .cols { grid-template-columns: 1fr; } }
</style>
