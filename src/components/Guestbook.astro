---
import { guestbook as g } from '../data/content';
import SectionLabel from './SectionLabel.astro';
import Icon from './Icon.astro';
---
<section id="guests" class="section bg-moss gb">
  <div class="wrap">
    <div class="head-row">
      <div class="section-head">
        <SectionLabel n="06" label="reviews & notes" />
        <h2 class="t-headline" data-reveal>{g.title}</h2>
      </div>
      <div class="score" data-reveal>
        <p><span class="num">{g.score}</span> <span class="stars">★★★★★</span></p>
        <a class="link" href="https://www.airbnb.com/" target="_blank" rel="noopener">{g.link} <Icon name="arrow" class="arrow" /></a>
      </div>
    </div>
  </div>

  <div class="rail" aria-label="Ratings and reviews">
    <article class="card ratings" data-reveal>
      <p class="t-label">Ratings</p>
      {g.ratings.map(([k, v]) => <div class="rt"><p>{k}</p><p>{v}</p></div>)}
    </article>
    {g.reviews.map(([q, who, when], i) => (
      <article class="card review" data-reveal style={`--d:${Math.min(i + 1, 4) * 0.07}s`}>
        <p class="stars">★★★★★</p>
        <p class="q">{q}</p>
        <p class="by"><span>{who}</span> <time class="t-label">{when}</time></p>
      </article>
    ))}
  </div>

  <div class="wrap">
    <div class="host">
      <h3 class="t-title" data-reveal>{g.host.title}</h3>
      <div class="host-row">
        <div class="who" data-reveal>
          <img src={g.host.photo} alt={`${g.host.name}, the host`} loading="lazy" />
          <div>
            <p class="t-lead quote">{g.host.quote}</p>
            <p class="t-small name">{g.host.name}</p>
          </div>
        </div>
        <div class="badges" data-reveal>
          {g.host.pills.map((p) => <p class="pill">{p}</p>)}
          <a class="btn btn-cream" href="#ask-tom">{g.host.cta} <Icon name="arrow" class="arrow" /></a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .score { text-align: right; display: flex; flex-direction: column; gap: 10px; align-items: flex-end; }
  .num { font-size: 44px; font-weight: 300; letter-spacing: -0.02em; }
  .stars { letter-spacing: .2em; font-size: 13px; }
  .link { display: inline-flex; gap: 8px; align-items: center; font-size: 15px; color: var(--cream-soft); }
  .link :global(.arrow) { width: 14px; height: 14px; }
  .rail { margin-top: 56px; display: grid; grid-auto-flow: column; grid-auto-columns: 348px; gap: 10px; overflow-x: auto; scrollbar-width: none;
    padding: 0 var(--pad); scroll-padding: 0 var(--pad); scroll-snap-type: x mandatory; }
  @media (min-width: 1440px) { .rail { padding-left: calc((100vw - var(--max)) / 2 + var(--pad)); } }
  .rail::-webkit-scrollbar { display: none; }
  .card { scroll-snap-align: start; border-radius: var(--radius); padding: 30px 28px; min-height: 326px; display: flex; flex-direction: column; }
  .ratings { background: var(--cream); color: var(--ink-text); }
  .ratings .t-label { color: var(--ink-soft); margin-bottom: 14px; }
  .rt { display: flex; justify-content: space-between; padding: 8px 0; border-bottom: 1px solid var(--ink-line); font-size: 15px; }
  .rt p:last-child { font-weight: 450; }
  .review { background: var(--card); }
  .q { margin-top: 18px; font-size: 18px; line-height: 1.6; }
  .by { margin-top: auto; display: flex; gap: 10px; align-items: baseline; font-size: 15px; font-weight: 450; }
  .by time { color: var(--cream-muted); font-size: 11px; }
  .host { margin-top: 96px; padding-top: 72px; border-top: 1px solid var(--line); }
  .host-row { margin-top: 40px; display: flex; justify-content: space-between; gap: 48px; }
  .who { display: flex; gap: 40px; align-items: flex-start; max-width: 820px; }
  .who img { width: 140px; height: 140px; border-radius: 50%; object-fit: cover; flex-shrink: 0; }
  .quote { color: var(--cream); }
  .name { margin-top: 14px; }
  .badges { display: flex; flex-direction: column; align-items: flex-end; gap: 8px; }
  @media (max-width: 900px) { .host-row { flex-direction: column; } .badges { align-items: flex-start; } .who { flex-direction: column; } .score { align-items: flex-start; text-align: left; } .rail { grid-auto-columns: 82%; } }
</style>
