---
import { location } from '../data/content';
import SectionLabel from './SectionLabel.astro';
import Icon from './Icon.astro';
const b = location.band;
---
<section id="location" class="section bg-ink loc">
  <div class="wrap">
    <div class="head-row">
      <div class="section-head">
        <SectionLabel n="05" label="location" />
        <h2 class="t-headline" data-reveal>{location.title}</h2>
        <p class="t-body-l intro" data-reveal>{location.intro}</p>
      </div>
      <a class="btn btn-glass" href={location.mapUrl} target="_blank" rel="noopener" data-reveal>View on Google Maps <Icon name="arrow" class="arrow" /></a>
    </div>

    <div id="nearby" class="route" data-carousel>
      <div class="track" data-track aria-label="Nearby, nearest first">
        {location.stops.map(([when, name, text], i) => (
          <div class="stop" data-reveal style={`--d:${Math.min(i, 7) * 0.06}s`}>
            <p class="t-label when">{when}</p>
            <span class={`dot ${i === 0 ? 'start' : ''}`} aria-hidden="true"></span>
            <p class="name">{name}</p>
            <p class="t-small">{text}</p>
          </div>
        ))}
      </div>
      <div class="arrows">
        <button class="round-btn" data-prev aria-label="Previous stops" disabled><Icon name="left" /></button>
        <button class="round-btn" data-next aria-label="Next stops"><Icon name="right" /></button>
      </div>
    </div>

    <div class:list={['band', { plain: !b.photo }]} data-band data-reveal>
      {b.photo && <img src={b.photo} alt="The countryside around the house" loading="lazy" />}
      <div class="band-shade" aria-hidden="true"></div>
      <p class="line l1">{b.line1}</p>
      <span class="rule" aria-hidden="true"></span>
      <p class="line l2">{b.line2}</p>
      <div class="places">
        {b.places.map(([n, t], i) => <div class={`place ${i === 0 ? 'on' : ''}`} data-place={i}><p class="t-label">{n}</p><p class="t">{t}</p></div>)}
      </div>
    </div>
  </div>
</section>

<style>
  .intro { max-width: 44ch; }
  .route { margin-top: clamp(56px, 7vw, 90px); }
  .track { display: grid; grid-auto-flow: column; grid-auto-columns: 162px; overflow-x: auto; scrollbar-width: none; scroll-behavior: smooth; scroll-snap-type: x mandatory; }
  .track::-webkit-scrollbar { display: none; }
  .stop { scroll-snap-align: start; position: relative; padding-right: 22px; display: flex; flex-direction: column; gap: 10px; }
  .when { color: var(--cream-muted); height: 17px; }
  .dot { position: relative; width: 11px; height: 11px; border-radius: 50%; background: var(--cream); margin: 6px 0 8px; }
  .dot::after { content: ''; position: absolute; left: 16px; top: 5px; width: 146px; height: 1px; background: var(--line); }
  .stop:last-child .dot::after { display: none; }
  .dot.start { background: transparent; border: 1.5px solid var(--cream); }
  .name { font-size: 18px; line-height: 1.35; }
  .arrows { display: flex; justify-content: flex-end; gap: 8px; margin-top: 40px; }
  .band { position: relative; margin-top: 64px; border-radius: 8px; overflow: hidden; aspect-ratio: 16 / 8.6; min-height: 460px; }
  .band.plain { background: var(--navy); }
  .band.plain .band-shade { display: none; }
  .band img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .band-shade { position: absolute; inset: 0; background: linear-gradient(180deg, rgb(13 12 10 / .5), rgb(13 12 10 / 0) 40%, rgb(13 12 10 / 0) 60%, rgb(13 12 10 / .62)); }
  .line { font-family: var(--font-head); position: absolute; font-size: clamp(30px, 4.4vw, 64px); font-weight: 300; letter-spacing: -0.025em; line-height: 1; }
  .l1 { top: 7%; left: 40px; }
  .l2 { top: 23%; right: 40px; }
  .rule { position: absolute; left: 0; right: 0; top: 18.5%; height: 1px; background: rgb(239 230 211 / .7); transform-origin: left; transform: scaleX(0); transition: transform 1.6s .3s var(--ease-out); }
  .band.in .rule { transform: none; }
  .places { position: absolute; left: 40px; right: 40px; bottom: 36px; display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; }
  .place { opacity: .38; transition: opacity .6s var(--ease); }
  .place.on { opacity: 1; }
  .place .t-label { font-size: 11px; }
  .place .t { font-size: clamp(20px, 2vw, 28px); font-weight: 300; margin-top: 4px; }
  @media (max-width: 700px) { .band { aspect-ratio: 3 / 4; } .places { grid-template-columns: 1fr 1fr; left: 22px; right: 22px; } .l1 { left: 22px; } .l2 { right: 22px; } }
</style>
