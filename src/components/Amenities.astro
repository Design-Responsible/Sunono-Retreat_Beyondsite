---
import { amenities } from '../data/content';
import SectionLabel from './SectionLabel.astro';
---
<section id="amenities" class="am bg-night" data-tabs>
  <div class="col">
    <div class="section-head">
      <SectionLabel n="04" label="amenities" />
      <h2 class="t-headline" data-reveal>{amenities.title[0]}<br />{amenities.title[1]}</h2>
      <p class="t-body-l intro" data-reveal>{amenities.intro}</p>
    </div>
    <div class="tabs" role="tablist" aria-label="Amenities" data-reveal>
      {amenities.groups.map((g, i) => (
        <button role="tab" id={`am-t${i}`} aria-controls={`am-p${i}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1} data-tab={i}>
          {g.name} <span>{g.items.length}</span>
        </button>
      ))}
    </div>
    {amenities.groups.map((g, i) => (
      <div role="tabpanel" id={`am-p${i}`} aria-labelledby={`am-t${i}`} hidden={i !== 0} class="panel" data-panel={i}>
        {g.items.map(([a, b], k) => <div class="row" style={`--d:${k * 0.04}s`}><p>{a}</p><p class="t-small">{b}</p></div>)}
      </div>
    ))}
  </div>
  <div class="photos" aria-hidden="true">
    {amenities.groups.map((g, i) => <img src={g.photo} alt="" loading="lazy" class={i === 0 ? 'on' : ''} data-photo={i} />)}
  </div>
</section>

<style>
  .am { display: grid; grid-template-columns: 1fr 1fr; min-height: 100svh; }
  .col { padding: clamp(96px, 11vw, 150px) var(--pad); display: flex; flex-direction: column; gap: 40px; max-width: 720px; justify-self: end; width: 100%; }
  .intro { max-width: 36ch; }
  .tabs { display: flex; flex-wrap: wrap; gap: 8px; }
  [role='tab'] { height: 36px; padding: 0 14px; border-radius: 999px; background: var(--glass); font-size: 15px; font-weight: 450; color: var(--cream); transition: background .3s, color .3s; }
  [role='tab'] span { color: var(--cream-muted); margin-left: 4px; font-weight: 400; }
  [role='tab'][aria-selected='true'] { background: var(--cream); color: var(--ink); }
  [role='tab'][aria-selected='true'] span { color: rgb(13 12 10 / .55); }
  .panel .row { display: flex; justify-content: space-between; align-items: baseline; gap: 20px; padding: 16px 0; border-bottom: 1px solid var(--line);
    font-size: 18px; animation: rowin .6s var(--ease-out) both; animation-delay: var(--d); }
  .panel .row:last-child { border-bottom: 0; }
  @keyframes rowin { from { opacity: 0; transform: translateY(10px); } }
  .photos { position: relative; overflow: hidden; min-height: 60vh; }
  .photos img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: 0; transform: scale(1.06); transition: opacity .9s var(--ease), transform 1.6s var(--ease-out); }
  .photos img.on { opacity: 1; transform: none; }
  @media (max-width: 900px) { .am { grid-template-columns: 1fr; } .col { max-width: none; } .photos { order: -1; min-height: 56vh; } }
</style>
