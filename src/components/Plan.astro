---
import { plan } from '../data/content';
import SectionLabel from './SectionLabel.astro';
import Icon from './Icon.astro';
---
<section id="plan" class="section bg-paper plan">
  <div class="wrap">
    <div class="head-row">
      <div class="section-head">
        <SectionLabel n="02" label="the plan" />
        <h2 class="t-headline" data-reveal>{plan.title[0]}<br />{plan.title[1]}</h2>
      </div>
      <p class="t-body-l intro" data-reveal>{plan.intro}</p>
    </div>

    <div class="drawings">
      {plan.drawings.map((d, i) => (
        <figure class={`drawing ${d.wide ? 'wide' : ''}`} data-reveal style={`--d:${i * 0.08}s`}>
          <div class="sheet">
            <!-- Placeholder line drawing; swap for the real plan (SVG or PNG) -->
            <svg viewBox={d.wide ? '0 0 600 260' : '0 0 300 260'} aria-label={`Plan placeholder: ${d.caption}`} role="img">
              {d.wide ? (
                <g>
                  <rect x="20" y="40" width="560" height="140" />
                  <line x1="140" y1="40" x2="140" y2="180" /><line x1="460" y1="40" x2="460" y2="180" />
                  <line x1="140" y1="110" x2="200" y2="110" /><line x1="400" y1="110" x2="460" y2="110" />
                  <rect class="soft" x="20" y="180" width="560" height="50" />
                  {[[80, 110, 1], [170, 75, 2], [300, 110, 3], [300, 160, 4], [420, 75, 5], [520, 205, 6]].map(([x, y, n]) => <g class="num"><circle cx={x} cy={y} r="11" /><text x={x} y={+y + 4}>{n}</text></g>)}
                </g>
              ) : (
                <g>
                  <rect x="40" y="40" width="220" height="180" />
                  <line x1="150" y1="40" x2="150" y2="220" class="dash" />
                  <g class="num"><circle cx="150" cy="130" r="11" /><text x="150" y="134">{i === 1 ? 7 : 8}</text></g>
                </g>
              )}
            </svg>
          </div>
          <figcaption class="t-caption">{d.caption}</figcaption>
        </figure>
      ))}
    </div>

    <div class="rooms" data-carousel>
      <div class="rooms-head">
        <p class="t-label lab">Rooms</p>
        <div class="arrows">
          <button class="round-btn" data-prev aria-label="Previous rooms" disabled><Icon name="left" /></button>
          <button class="round-btn" data-next aria-label="Next rooms"><Icon name="right" /></button>
        </div>
      </div>
      <div class="track" data-track>
        {plan.rooms.map((r) => (
          <article class="room">
            <p class="n">{r.n}</p>
            <h3 class="t-card">{r.name}</h3>
            <div class="tags">{r.tags.map((t) => <p>{t}</p>)}</div>
            <p class="t-small">{r.text}</p>
          </article>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .intro { max-width: 40ch; }
  .drawings { margin-top: clamp(56px, 7vw, 96px); display: grid; grid-template-columns: 2fr 1fr 1fr; gap: 16px; }
  .drawing { margin: 0; display: flex; flex-direction: column; gap: 12px; }
  .sheet { border-radius: var(--radius); background: var(--rust-deep); padding: 28px; aspect-ratio: 4 / 3; display: grid; place-items: center; }
  .wide .sheet { aspect-ratio: auto; height: 100%; }
  svg { width: 100%; height: auto; max-height: 100%; fill: none; stroke: var(--cream); stroke-width: 1.4; }
  svg .soft { stroke-dasharray: 4 5; opacity: .6; }
  svg .dash { stroke-dasharray: 3 6; opacity: .5; }
  svg .num circle { fill: var(--cream); stroke: none; }
  svg .num text { fill: var(--rust); stroke: none; font: 500 11px var(--font); text-anchor: middle; }
  .rooms { margin-top: clamp(64px, 8vw, 110px); }
  .rooms-head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; }
  .lab { color: var(--cream-muted); }
  .arrows { display: flex; gap: 8px; }
  .track { display: grid; grid-auto-flow: column; grid-auto-columns: calc((100% - 48px) / 4); gap: 16px; overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; scroll-behavior: smooth; }
  .track::-webkit-scrollbar { display: none; }
  .room { scroll-snap-align: start; background: var(--rust-deep); border-radius: var(--radius); padding: 28px; display: flex; flex-direction: column; gap: 14px; min-height: 300px; }
  .n { width: 28px; height: 28px; border-radius: 50%; background: var(--cream); color: var(--rust); display: grid; place-items: center; font-size: 13px; font-weight: 500; }
  .tags { display: flex; flex-wrap: wrap; gap: 6px; }
  .tags p { font-size: 13px; padding: 3px 10px; border-radius: 999px; background: var(--card); color: var(--cream-soft); }
  .room .t-small { margin-top: auto; }
  @media (max-width: 1000px) { .drawings { grid-template-columns: 1fr 1fr; } .wide { grid-column: 1 / -1; } .track { grid-auto-columns: calc((100% - 16px) / 2); } }
  @media (max-width: 600px) { .drawings { grid-template-columns: 1fr; } .track { grid-auto-columns: 82%; } }
</style>
