---
// Scroll-driven hero (Skyline style): the hero stays pinned while scrolling
// plays the drone flight frame by frame, from the estate down to the house.
// Frames: public/hero-frames/l (desktop) and /s (phone), f001…f075.webp.
// To go back to the photo slideshow, use Hero.astro in pages/index.astro.
import { hero } from '../data/content';
const FRAMES = 75;
---
<section class="hs" aria-label="Introduction" data-scrub data-frames={FRAMES} data-base="/hero-frames">
  <div class="pin">
    <img class="poster" src="/hero-frames/l/f001.webp" alt="Flying in over the estate towards the house" fetchpriority="high" />
    <canvas class="cv" aria-hidden="true"></canvas>
    <div class="scrim" aria-hidden="true"></div>
    <div class="scrim deep" aria-hidden="true"></div>
    <div class="wrap content">
      <div class="titles">
        <h1 class="t-display l1">{hero.line1}</h1>
        <p class="t-display l2">{hero.line2}</p>
        <p class="t-lead sub">{hero.sub}</p>
      </div>
      <div class="meta">
        <div class="facts">{hero.place.map((f) => <p>{f}</p>)}</div>
        <div class="facts">{hero.facts.map((f) => <p>{f}</p>)}</div>
      </div>
      <p class="hint t-label" aria-hidden="true"><span class="track"><i data-scrub-bar></i></span>Scroll to arrive</p>
    </div>
  </div>
</section>

<style>
  .hs { position: relative; height: 320vh; background: var(--ink); }
  .pin { position: sticky; top: 0; height: 100svh; min-height: 620px; overflow: hidden; }
  .poster, .cv { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .poster { animation: hz 3.2s cubic-bezier(.25,.6,.25,1) both, hf 1.4s ease-out both; }
  .hs.ready .poster { visibility: hidden; animation: none; }
  @keyframes hz { from { transform: scale(1.12); } }
  @keyframes hf { from { opacity: 0; } }
  .scrim { position: absolute; inset: 0; pointer-events: none;
    background: linear-gradient(0deg, rgb(13 12 10 / .78) 0%, rgb(13 12 10 / .3) 38%, rgb(13 12 10 / 0) 60%), linear-gradient(180deg, rgb(13 12 10 / .45), rgb(13 12 10 / 0) 22%); }
  /* later frames are brighter (white house, sunlit leaves): deepen the shade as you scroll */
  .deep { background: linear-gradient(20deg, rgb(13 12 10 / .7) 0%, rgb(13 12 10 / .25) 45%, rgb(13 12 10 / 0) 70%); opacity: var(--p, 0); }
  .content { position: absolute; left: 0; right: 0; bottom: 0; padding-bottom: 44px; display: grid; grid-template-columns: 1fr auto; align-items: end; gap: 24px 40px; }
  .titles { grid-column: 1 / -1; }
  .l1, .l2 { opacity: 0; transform: translateY(40px); animation: rise 1.4s var(--ease-out) forwards; }
  .l1 { animation-delay: .5s; }
  .l2 { animation-delay: .65s; }
  @keyframes rise { to { opacity: 1; transform: none; } }
  .sub { max-width: 34ch; margin-top: 22px; color: var(--cream); opacity: 0; transform: translateY(24px); animation: rise 1.2s .85s var(--ease-out) forwards; }
  .meta { display: flex; gap: 10px 36px; flex-wrap: wrap; font-size: 15px; color: var(--cream-soft); opacity: 0; animation: rise 1.2s .95s var(--ease-out) forwards; }
  .facts { display: flex; gap: 6px; }
  .hint { display: flex; align-items: center; gap: 14px; color: var(--cream-soft); font-size: 11px; opacity: 0; animation: rise 1.2s 1.1s var(--ease-out) forwards; }
  .track { width: 64px; height: 2px; background: rgb(239 230 211 / .22); border-radius: 2px; overflow: hidden; }
  .track i { display: block; height: 100%; background: var(--cream); transform-origin: left; transform: scaleX(0); }
  @media (max-width: 700px) { .content { grid-template-columns: 1fr; padding-bottom: 28px; } .hint { order: -1; } }
  @media (prefers-reduced-motion: reduce) { .hs { height: auto; } .pin { position: relative; } .cv, .hint { display: none; } }
</style>
