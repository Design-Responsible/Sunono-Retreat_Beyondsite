---
import { closer } from '../data/content';
---
<section class="closer" aria-label="Closing photo" data-closer>
  <div class="pin">
    <p class="line" data-closer-line>{closer.line[0]}<br />on <span class="chip-slot" data-chip-slot></span> {closer.line[1]}</p>
    <div class="win" data-closer-win aria-hidden="true">
      {closer.steps.map((s, i) => <img src={s.src} alt="" data-step-img={i} class={i === 0 ? 'on' : ''} />)}
      <img class="chip-img on" src={closer.chip} alt="" data-chip-img />
      <div class="shade"></div>
    </div>
    <div class="steps">
      {closer.steps.map((s, i) => <p class="step" data-step={i}>{s.text}</p>)}
    </div>
  </div>
</section>

<style>
  .closer { position: relative; height: 420vh; background: var(--ink); }
  .pin { position: sticky; top: 0; height: 100vh; overflow: hidden; display: grid; place-items: center; }
  .line { font-family: var(--font-head); position: relative; z-index: 1; text-align: center; font-size: clamp(44px, 5.8vw, 84px); font-weight: 300; letter-spacing: -0.03em; line-height: 1.12; transition: opacity .3s; }
  .chip-slot { display: inline-block; width: 1.75em; height: .88em; vertical-align: -.06em; margin: 0 .2em; }
  .win { position: absolute; z-index: 2; overflow: hidden; left: 50%; top: 50%; will-change: width, height, border-radius; border-radius: 40px; width: 148px; height: 74px; translate: -50% -50%; }
  .win img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: 0; transition: opacity .8s var(--ease); }
  .win img.on { opacity: 1; }
  .chip-img { z-index: 1; }
  .shade { position: absolute; inset: 0; z-index: 2; background: linear-gradient(90deg, rgb(13 12 10 / .58), rgb(13 12 10 / .2)); opacity: var(--shade, 0); }
  .steps { position: absolute; z-index: 3; left: var(--pad); top: 50%; translate: 0 -50%; display: flex; flex-direction: column; gap: 8px; pointer-events: none; }
  .step { font-family: var(--font-head); font-size: clamp(32px, 4.4vw, 64px); font-weight: 300; letter-spacing: -0.025em; line-height: 1.15; opacity: 0; transform: translateY(20px); transition: opacity .7s var(--ease), transform .9s var(--ease-out); }
  .step.on { opacity: 1; transform: none; }
  .step.past { opacity: .35; transform: none; }
  @media (prefers-reduced-motion: reduce) { .closer { height: auto; } .pin { position: relative; height: 80vh; } .win { display: none; } }
</style>
